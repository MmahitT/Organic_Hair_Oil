# Copy to server/.env (or the repo root .env). Never commit real values.
NODE_ENV=development
PORT=5001   # 5000 is used by macOS AirPlay Receiver
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=false
LOG_LEVEL=info

# Local dev DB: run `npm run dev:db` (in-memory/persistent MongoDB replica set). Production: MongoDB Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=beauty_organic

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_to_a_random_string_of_at_least_32_chars
JWT_REFRESH_SECRET=change_me_to_a_different_random_string_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=14
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
BCRYPT_SALT_ROUNDS=12

# First superadmin created by `npm run seed` (choose a strong password; change after first login)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Cloudinary (image uploads from the admin panel). Leave empty until you have an account.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=beauty-organic
